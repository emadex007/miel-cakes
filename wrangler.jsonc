{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miel-cakes",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": { "enabled": true },

  // D1 database: run `npx wrangler d1 create miel_cakes_db`
  // and paste the database_id it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miel_cakes_db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for photos and videos: run `npx wrangler r2 bucket create miel-cakes-media`
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "miel-cakes-media"
    }
  ]
}
